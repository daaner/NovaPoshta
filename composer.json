{
    "name": "daaner/novaposhta",
    "description": "NovaPoshta (API 2.0) for Laravel 7+",
    "keywords": [
        "daaner",
        "novaposhta",
        "ukraine-delivery",
        "laravel-np",
        "laravel-novaposhta",
        "delivery"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Daan",
            "email": "daan@ukr.net"
        }
    ],
    "require": {
        "php": ">=7.4",
        "laravel/framework": ">=7.0",
        "ext-json": "*"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/promises": "1.5",
        "orchestra/testbench": "^5.0|^6.0",
        "phpunit/phpunit": "^8.5|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Daaner\\NovaPoshta\\Facades\\": "src/Facades",
            "Daaner\\NovaPoshta\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Daaner\\NovaPoshta\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "disable-tls": false
    },
    "extra": {
        "laravel": {
            "providers": [
                "Daaner\\NovaPoshta\\NovaPoshtaServiceProvider"
            ],
            "aliases": {
                "NovaPoshta": "Daaner\\NovaPoshta\\Facades\\NovaPoshta"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
